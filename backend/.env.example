# ---- Core ----
NODE_ENV=development
PORT=5000

# ---- Database (MongoDB Atlas or local) ----
MONGODB_URI=mongodb://127.0.0.1:27017/wearly

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRY=7d

# ---- CORS (frontend origin) ----
CORS_ORIGIN=http://localhost:5173

# ---- Seed superadmin ----
ADMIN_EMAIL=admin@wearly.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Wearly Admin

# ---- Cloudinary (image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay (payments, INR) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Logging (winston): error|warn|info|debug
CONSOLE_LOG_TYPE=info
FILE_LOG_TYPE=error
